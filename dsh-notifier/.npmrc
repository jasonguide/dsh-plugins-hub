registry=https://registry.npmjs.org/
node-linker=hoisted
# peerDependencies 只声明「本插件兼容的宿主契约」，供 DSH 的兼容性闸门
# （evaluatePluginCompatibility）读取；其中的 @deepseek-ai/dsh-* 在 npm 上
# 只有陈旧的 0.0.1-rc.1（其传递依赖 dsh-type-meta 未发布），自动安装必然失败。
# 本插件编译期只 `import type` 这些包，类型由 scripts/link-dsh-types.mjs
# 从本机 DSH 安装软链提供，因此这里关闭自动安装 peer。
auto-install-peers=false
